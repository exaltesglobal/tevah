{
  "name": "tevah",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @tevah/web dev",
    "build": "pnpm --filter @tevah/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @tevah/web db:migrate",
    "db:seed": "pnpm --filter @tevah/web db:seed"
  }
}
