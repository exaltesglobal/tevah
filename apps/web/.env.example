# App connects as a non-owner role so Postgres row-level security applies.
DATABASE_URL=postgres://tevah_app:tevah_app@localhost:5432/tevah_dev
# Owner role, used only for migrations and seeding.
DATABASE_ADMIN_URL=postgres://tevah:tevah@localhost:5432/tevah_dev
# Password for the tevah_app role, set by migrations.
APP_DB_PASSWORD=tevah_app

# First admin created by `pnpm db:seed`
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change-me-please
