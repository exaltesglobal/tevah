{
  "name": "@tevah/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:hostinger": "next build --webpack && node scripts/flatten-standalone.mjs && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
